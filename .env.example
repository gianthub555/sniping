# Credentials, connections, landing services and the stake only.
# The trading rules (what to buy, how much, when to sell) are in src/config/rules.rs;
# nothing in this file changes them.

# ---------------------------------------------------------------------------
# Connections
# ---------------------------------------------------------------------------
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=
# Yellowstone gRPC stream; the bot checks the endpoint and token at startup.
# Helius LaserStream: https://laserstream-mainnet-{ewr,pitt,slc,lax,lon,ams,fra,tyo,sgp}.helius-rpc.com
# with GRPC_TOKEN = your Helius API key (mainnet needs a Business or Professional plan).
LOCAL_GRPC_URL=https://laserstream-mainnet-ewr.helius-rpc.com
GRPC_TOKEN=
# Second provider, used automatically when the first fails its health check (every 5 s).
FALLBACK_RPC_ENDPOINT=
FALLBACK_GRPC_URL=
FALLBACK_GRPC_TOKEN=

# ---------------------------------------------------------------------------
# Wallet (base58 string or JSON byte array). PUBKEY is optional; if set it must match.
# ---------------------------------------------------------------------------
PRIVATE_KEY=
PUBKEY=

# ---------------------------------------------------------------------------
# Dry run: simulate every transaction instead of sending it. Set to false to trade.
# DRY_RUN_WALLET (optional) simulates as another funded public key, so you can test
# before funding the bot wallet. Paper buys and sells land as late as live ones: unset
# latencies draw from the measured Frankfurt landing delays, a number or comma list (ms)
# replaces them, 0 fills at once. DRY_RUN_CHARGE_FEES books modeled fees and tips.
# ---------------------------------------------------------------------------
DRY_RUN=true
DRY_RUN_WALLET=
DRY_RUN_BUY_LATENCY_MS=
DRY_RUN_SELL_LATENCY_MS=
DRY_RUN_CHARGE_FEES=true

# ---------------------------------------------------------------------------
# Stake per buy in SOL. The rules buy the full stake when the dev buy is 1 SOL or more
# and 65% of it below that. ./bot.sh buy-size and the dashboard change it at runtime.
# ---------------------------------------------------------------------------
BUY_SOL_AMOUNT=0.1

# ---------------------------------------------------------------------------
# Landing
# ---------------------------------------------------------------------------
# Compute unit limit per transaction (0 = omit). pump.fun buys use a median 94k CU and up to 115k
# (260 simulated buys to 26 Sep 2026; 20k of it creates the token account), sells 51k-68k. The
# priority fee is paid on the whole limit and producers rank by fee over the limit: keep it just
# above the maximum.
CU=120_000
PRIORITY_FEE_MICRO_LAMPORT=20_000
# Account data a buy may load, in MiB (buys only; unset = the 64 MiB default). Block producers
# rank by fee over cost, and the cost counts this limit: 16 MiB is ~12k CU cheaper than 64. A
# pump.fun buy loads ~12.6 MiB (pump.fun's program alone is 10 MiB). Paper mode simulates with it.
LOADED_DATA_LIMIT_MIB=16
# Buy only launches whose block producer is in these continents (comma list: EU, NA, AS, ...;
# empty: every launch). From Frankfurt we were first on 36% of raced launches produced in Europe,
# 11% in the US and 20% in Asia (76 real landings, 25-26 Sep 2026). Worth it on Nozomi with a
# higher bid (every lost race pays the priority fee); pointless with Jito bundles.
LEADER_REGIONS=
# Optional, sells only (defaults to PRIORITY_FEE_MICRO_LAMPORT).
SELL_PRIORITY_FEE_MICRO_LAMPORT=
# Landing service: JITO, NOZOMI, ZERO_SLOT, HELIUS, or empty for plain RPC.
CONFIRM_SERVICE=
# Send every transaction to all of these at once (comma separated); the copies share one
# signature, so only one can execute. Each listed service's tip rides in the transaction.
CONFIRM_SERVICES=
SELL_CONFIRM_SERVICES=
# Tips in SOL. Jito uses JITO_TIP_VALUE (min 0.000001); Nozomi and 0slot use
# THIRD_PARTY_FEE (min 0.001; Nozomi drops smaller tips).
JITO_TIP_VALUE=0.0001
# No-fail buys: CONFIRM_SERVICES=JITO with JITO_BUNDLE_ONLY=true sends each buy as a Jito bundle;
# one that would fail (lost race) is dropped and costs nothing. Raise JITO_TIP_VALUE to land
# earlier (paid only on landed buys).
# Not working as of 26 Sep 2026: Jito accepted but dropped every bundle sent without an auth key
# (0 of 30 landed, status "Invalid" within 150 ms, every region; `probe --vias jito` shows it).
JITO_BUNDLE_ONLY=false
# Near-free buys through Nozomi (NOZOMI_API_KEY only, no Jito key): each buy goes both as a
# Nozomi bundle (block builders, a failing buy is dropped free) and as a plain send of the same
# transaction (direct paths; a failing copy pays the 5,000-lamport base fee when
# PRIORITY_FEE_MICRO_LAMPORT=0). Neither the tip nor the priority fee moves the block position
# (paired probes, 26 Sep 2026), so keep BUY_THIRD_PARTY_FEE at Nozomi's minimum and the
# priority fee at 0. Sells keep SELL_CONFIRM_SERVICES and THIRD_PARTY_FEE.
NOZOMI_BUNDLE=false
BUY_THIRD_PARTY_FEE=0.001
# With NOZOMI_BUNDLE: also send each buy as a Jito bundle (needs JITO_UUID and
# JITO_BUNDLE_ONLY=true). Same transaction, lands once, on whichever builder is building; the
# Jito tip (JITO_TIP_VALUE) is paid on landed buys. Paired probes 26 Sep 2026: Jito ahead on 1
# of 5 launches, Nozomi on 3, equal on 1.
JITO_COPY=false
# Buy only inside this daily window (UTC, HH:MM-HH:MM, may wrap past midnight); sells always run.
# Unset: always. Fewer fast snipers compete at US night: a fast sniper was in the launch slot on
# 42-48% of followed launches 21:00-01:00 US Eastern and 67-84% at 07:00-09:00 (26 Sep 2026).
TRADING_HOURS_UTC=
# Paper buys land at a block position drawn from 47 real landings (the position decides who
# bought first) instead of at a time after sending. The time model filled 42% of races where
# live filled 8-17% (26 Sep 2026), and the coins it filled that live cannot win are the better
# ones. Paper sells land the same way, counted from the stream's position at the decision.
# false: the time model (DRY_RUN_BUY_LATENCY_MS, DRY_RUN_SELL_LATENCY_MS).
DRY_RUN_FILL_BY_POSITION=true
# Jito auth key (UUID) from a Jito support ticket (discord.gg/jito); sent as x-jito-auth.
# Jito support: bundles are hard to land without one.
JITO_UUID=
THIRD_PARTY_FEE=0.001
# Optional explicit endpoints; otherwise the fastest region is picked at startup.
JITO_BLOCK_ENGINE_URL=
NOZOMI_API_URL=
NOZOMI_API_KEY=
ZERO_SLOT_API_URL=
ZERO_SLOT_API_KEY=
HELIUS_SENDER_URL=
HELIUS_SENDER_TIP_SOL=0.000005

# ---------------------------------------------------------------------------
# Optional price source when no on-chain quote is available
# ---------------------------------------------------------------------------
BIRDEYE_API_KEY=

# ---------------------------------------------------------------------------
# Local dashboard (no authentication unless DASHBOARD_PASSWORD is set: keep it on
# 127.0.0.1 and reach it through a tunnel)
# ---------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_ADDR=127.0.0.1:8787
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Shred stream (optional): sees a launch before it executes. Either a local Jito ShredStream
# proxy's entries service (--grpc-service-port; Jito's own feed shut down on 5 Sep 2026, the
# proxy's forward-only mode takes DoubleZero multicast shreds instead), or a decoded shred
# provider such as ShredStream.com. The deployer's balance is fetched by RPC for a shred
# sighting; SHRED_SNIPE=true buys from shred sightings, false only measures the head start
# (logs/shred_lead.csv).
# Helius preprocessed stream (before execution, ~4-5 ms ahead of LaserStream from Frankfurt;
# ~58M credits a month); the API key is taken from RPC_ENDPOINT.
# HELIUS_PREPROCESSED=true
# SHRED_PROXY_URL=http://127.0.0.1:9999
# Deshredded entries pushed to this server over UDP (AllenHark Direct UDP: each datagram is the
# slot, u64 LE, then a bincode Vec<Entry>). Open the port and register this IP with the provider.
# SHRED_UDP_PORT=8001
# SHRED_GRPC_URL=<host>:50051
# SHRED_TOKEN=
# SHRED_SNIPE=false

# Alerts (Telegram): no launch for 60 s, a feed reconnect, a blockhash older than 5 s,
# 10 sends failing in a row.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Hot path (src/hot). FAST_PATH=true: its own threads read the early feeds, decide, build and sign
# each buy without allocating, and record per-stage stamps (logs/hot_stamps.csv, logs/hot_stats.log).
# With DRY_RUN=true it sends nothing (unless HOT_DRY_LANES). With DRY_RUN=false it sends real buys
# only when HOT_LIVE=true as well; otherwise it stays off and the slow path buys as before.
FAST_PATH=false
HOT_LIVE=false
# With the hot path live, LIVE_SLOW_PATH_BUYS=false keeps the slow path from buying the launches the
# hot path leaves to it (and regular-stream ones): every live buy then goes through the hot lanes.
LIVE_SLOW_PATH_BUYS=true
# Live-test limits (utils::live_guard; each off when empty). Buying stops for good, until restart,
# after LIVE_MAX_BUYS buys that got tokens, LIVE_MAX_INCLUDED buys included in a block (tokens or a
# failure on chain), after LIVE_MAX_FAILED_IN_A_ROW buys in a row that got
# none, when the wallet holds under LIVE_MIN_WALLET_SOL, or when a hot feed is silent for
# LIVE_FEED_STALL_SECS. Open positions are still sold. Paper buys count the same way in DRY_RUN.
LIVE_MAX_BUYS=
LIVE_MAX_INCLUDED=
LIVE_MAX_FAILED_IN_A_ROW=
LIVE_MIN_WALLET_SOL=
LIVE_FEED_STALL_SECS=
# Fee engine (src/hot/fee.rs). FEE_MODE: off (the lanes' default bid and 10% outbid, as before),
# table (the per leader-client and launch-tier table: floor = p92.5 of pump.fun bids over the class's
# last 50 slots, x3 on contested tiers, min 10 lamports/CU; a slow controller on our positions; caps
# per class, EV cap kappa x buy size, BUY_FEE_CAP_SOL; daily budget; breakers), or ladder (a fixed
# total fee per launch from FEE_LADDER_SOL, arms balanced within each leader client class).
FEE_MODE=off
FEE_KAPPA=0.02
# The daily budget applies in table mode (a fee test has its own stops).
FEE_DAILY_BUDGET_SOL=0.05
# The cap: max(kappa x buy size - tip, the class's median first-buyer fee), at least 10 lamports/CU,
# at most BUY_FEE_CAP_SOL. Until 10 first buyers are seen live a class uses FEE_FIRST_FEE_<CLASS>
# (lamports/CU; A4: AGAVE 5, JITOAGAVE 5, FIREDANCER 37.4, FRANKENDANCER 37.4, HARMONIC 25.4, BAM 37.4,
# OTHER 5).
# Routes (table mode, the owner's of 8 Oct), FEE_ROUTE_<CLASS> = skip | fee (the class's gateways,
# the engine's fee) | jito (a one-transaction Jito bundle only, tip inside the buy, priority fee at
# the class floor, jitodontfront) | fee+jito | fee-under-cap | alternate (launch by launch in turn:
# jito, then one gateway copy). Defaults: JITORELAYER (JitoLabs behind a Jito relayer) jito,
# JITOAGAVE (JitoLabs, no relayer) alternate, AGAVE fee, FIREDANCER fee,
# FRANKENDANCER fee, BAM fee, HARMONIC skip (logged, no bid), OTHER skip. The gateways a class's buy
# may use (one per buy, in turn, paying only its tip): FEE_GATEWAYS_<CLASS> (0slot,everstake).
# The Jito tip: FEE_JITO_TIP_START_SOL (0.0003) until rivals' Jito tips on followed launches are
# seen, then their p50 or Jito's tip floor p75, whichever is higher, at most FEE_JITO_TIP_CAP_SOL
# (0.001). Rate-limit refusals from the block engine are counted and logged ("RATE LIMITED").
# Fee tests (ladder mode): FEE_LADDER_<CLASS> = arms fee:SOL | jito:SOL | skip, balanced per class;
# a class without a list takes FEE_LADDER_SOL as fee arms.
FEE_LADDER_SOL=0.002,0.005,0.010
# Optional: FEE_FLOOR_QUANTILE (0.925), FEE_FLOOR_SLOTS (50), FEE_CONTESTED_MULT (3),
# FEE_MIN_LAMPORTS_PER_CU (10), FEE_STEP (0.2, 0.125-0.25), FEE_TARGET_POSITION (2),
# FEE_MIN_SAMPLES (10), FEE_SMOOTH_LAUNCHES (8), FEE_HARMONIC_TIP_MULT (1), FEE_TIP_CAP_SOL (0.002),
# FEE_FILL_FAIL_RATE (0.3), FEE_REGIME_ATTEMPTS (30), FEE_REGIME_FLOOR (0.2), FEE_JUMP_MULT (3).
# The distance rule (src/hot/distance.rs, the owner's of 8 Oct): every DISTANCE_MEASURE_SECS (300) the
# QUIC handshake time to the TPU of every leader of this epoch and the next is measured (cached per
# identity). A launch is bought only when its slot's leader answers under DISTANCE_MAX_RTT_MS (30, so
# London counts); in a leader's last slot with a farther next leader, only when the create came in
# the slot's first DISTANCE_LAST_SLOT_MS (165: ~62% of a 267 ms slot). Skips: logs/route_skips.csv; per day: logs/distance_daily.csv.
# DISTANCE_RULE=off turns it off.
DISTANCE_RULE=on
DISTANCE_MAX_RTT_MS=30
# 133 ms = ~62% of a slot, as at 165 ms when slots took 267 ms; slots took 215 ms on 15 Oct 2026.
DISTANCE_LAST_SLOT_MS=133
# spsc (a pinned decision thread fed by single-producer rings) or inline (decide on the feed thread).
HOT_HANDOFF=spsc
# Build and sign a buy for every create, bought or not, so the timing has samples on every launch.
HOT_SHADOW=false
# Busy-poll the feed sockets and the decision thread (one core each) instead of sleeping.
HOT_BUSY_POLL=true
# While idle, re-run a throwaway decode / derive / sign this often (us; 0: never) so the path stays
# in the CPU caches (measured live: p50 64 -> 53 us, p99 142 -> 137 us).
HOT_WARM_US=1000
# Finish each buy's signature from an Ed25519 nonce made ahead of time on its own thread (2026-10-11;
# ~3 us instead of 25-46 us for the keypair's signature). false: the keypair signs as before.
HOT_PRESIGN=true
# Sells go out on the hot lanes (the decision thread's warm sockets, presigned, one tip per tipping
# lane) instead of the slow path's HTTP client; the landing is awaited as before. Live, spsc only;
# in DRY_RUN with HOT_DRY_LANES the paper sells' unlandable copies (all-zero blockhash) go out the
# same way, to time the sell path in a paper run.
HOT_SELL_LANES=true
# The decision's table lookups (follow list, deployer history, balance, wallet age, records) made
# when the create arrives, inside its bundle window; at the window's end only arithmetic is left
# (2026-10-11; decide 8.3 -> ~1 us). false: all of it at the window's end, as before.
HOT_PREDECIDE=true
# The idle warm-up (HOT_WARM_US) in steps of at most one address search, the rings looked at
# between steps, so a create waits one step instead of a whole warm-up (the SPSC hand-off's tail).
# false: one warm-up in one go, as before.
HOT_WARM_STEPS=true
# The creator vault derived once per creator (a table on the decision thread). false: every time.
HOT_VAULT_CACHE=true
# Paper runs never sign with the wallet's key (2026-10-12, always): the hot path's unlandable lane
# copies are signed by a throwaway key made at each start, and the slow path's paper simulations
# carry a blank signature (they simulate with signature checks off).
# File writes off the tokio runtime (2026-10-12): a live buy's trade row after its sell monitor
# starts, the reference wallet's trades and the shred-lead rows, on one writer thread; a full queue
# drops and counts the row (hot_stats.log "file writer"). false: written where they happen.
ASYNC_FILE_WRITES=false
# Durable-nonce fan-out (2026-10-12): every lane of a buy's route gets its own copy, all on one nonce
# account and value, each paying only its own lane's tip, so at most one lands and one tip is paid.
# The accounts (authority: the wallet) are listed in nonce_accounts.txt and created by the owner;
# none listed: the switch does nothing. An account is reused only after its value is seen to change
# (our copy landed, or our cancel landed); a copy not landed within 2 s is cancelled (an advance,
# 5,000 lamports and a small fee); each account is advanced once at a live start. DRY_RUN uses
# synthetic accounts (nothing on chain). HOT_SELL_FANOUT does the same for sells (see below).
HOT_NONCE_FANOUT=false
# Sells the same way (live, with HOT_SELL_LANES): one copy per lane on one nonce, each paying only its
# lane's tip; re-bid every slot on the same nonce with the fee doubled (4 times at most, the whole
# priority fee under SELL_FEE_CAP_SOL, else BUY_FEE_CAP_SOL); then cancelled, and once the cancel has
# settled (no old copy can land) a fresh sell with a fresh quote. With it on the bot never stops
# selling while tokens remain. The sell's instructions are built once per position, at the buy.
HOT_SELL_FANOUT=false
SELL_FEE_CAP_SOL=
# An insider's (the dev's or a bundle wallet's) pump.fun sell seen on the preprocessed stream, before
# it executes, triggers our sell then (4-10 ms before the regular stream shows it). Always recorded and
# checked against the regular stream (logs/preexec_sightings.csv; hot_stats.log: how many did not
# execute); acted on only with this on. Paper first: the share that did not execute decides.
SELL_PREEXEC_TRIGGERS=false
# Pin the preprocessed feed, the UDP feed and the decision thread to these cores.
HOT_PIN=true
HOT_CORES=5,6,7
# The lane threads' own core (each HTTPS, relay and QUIC lane's sender); nothing else runs there.
# Empty: they share the other cores. deploy/cpu-isolation.sh isolates 4-7 at boot.
HOT_LANE_CORE=4
# The runtime's blocking threads stay once started (true). Off: tokio's default, one idle for 10 s
# exits and the next blocking call starts another; every start and exit flushes the TLB of each core
# running the bot, the hot cores included (~45 IPIs a minute on cores 5 and 7, 14 Oct, Frankfurt).
KEEP_BLOCKING_THREADS=true
# Everstake as a plain-HTTP lane written by the decision thread on a kept-alive HTTP/1.1 connection,
# like 0slot (true), under its 10/s limit less one for the ping. Off: the threaded reqwest lane
# (HTTP/2), ~105 us from hand-over to write, p99 1.1 ms (Frankfurt paper run, 14 Oct).
HOT_EVERSTAKE_DIRECT=true
# The fan-out's copies made and sent in this order, in one pass (lane names; the others follow).
# Each copy is signed in turn, so the first lane's leaves a signature or two earlier. Empty: Jito,
# Everstake, ... 0slot, threaded lanes first.
HOT_FANOUT_ORDER=0slot,everstake,jito
# The address search's on-curve test as a Legendre symbol (crrl) instead of the library's point
# decompression (true): the same addresses, each try ~3 us instead of ~5.5 us on Frankfurt's CPU.
HOT_FAST_PDA=true
# pumpfeed's API (its shred-derived blockhash is the fallback when RPC's is old or missing).
PUMPFEED_API_ADDR=127.0.0.1:7878

# Hot-path send lanes. The same signed bytes go out in this order, all within a fraction of a ms:
# the staked gateways at once (Helius Sender SWQoS-only, Everstake SWQoS, AllenHark Relay, Triton
# Jet), then 0slot and Nozomi, then Jito, then direct QUIC to the leader (unstaked, the last
# fallback). Each lane: LANE_<NAME>_ENABLED, _URL, _KEY, _TIP_LAMPORTS. The buy carries one tip per
# enabled tipping lane (to one of its published accounts, rotated per send).
# LANE_SET=race: every enabled lane (the lane race); default: only those in LANE_DEFAULT.
LANE_SET=race
LANE_DEFAULT=
# LANE_ROTATE=true: each buy goes through one lane instead of all, the lanes that are on taking
# turns (0slot, Everstake, Helius, AllenHark, Triton, Nozomi, Jito, QUIC), and pays only that lane's
# tip (the others are written as 0-lamport transfers), so the lane that landed it is known.
LANE_ROTATE=false
# The lanes that take turns (names, e.g. 0slot,everstake; empty: every lane that is on). A lane on
# but left out (jito) still carries the copies the fee engine asks for.
LANE_ROTATE_LANES=
# Helius Sender, SWQoS-only (default http://fra-sender.helius-rpc.com/fast?swqos_only=true; min
# tip 0.000005 SOL). A Helius API key raises its rate limit from 1/s to 50/s.
LANE_HELIUS_ENABLED=true
LANE_HELIUS_URL=
LANE_HELIUS_KEY=
LANE_HELIUS_TIP_LAMPORTS=5000
# Everstake SWQoS pay-as-you-go: RPC path, no key. One persistent HTTP/2 connection: h2c on their
# plain-HTTP port (offered; https://fra-swqos.everstake.one works too, with TLS). Every buy carries a
# transfer of at least 1,000,000 lamports to one of their tip accounts (github.com/everstake/
# everstake-swqos-docs, RESOURCES.md), rotated per send, never through a lookup table. At most 10
# sends a second (their default limit); a copy over it is not sent on this lane.
LANE_EVERSTAKE_ENABLED=true
LANE_EVERSTAKE_URL=http://fra-swqos.everstake.one
LANE_EVERSTAKE_KEY=
LANE_EVERSTAKE_TIP_LAMPORTS=1000000
LANE_EVERSTAKE_TIP_ACCOUNTS=J4cL8c22KNLHwheuWxK1SCYBWASWPGhEi6xvcGyf6o3S,EzuhsszPxRUHBwGPXtKoqCB58EiTJ1QiYA2XrhbUEFbr,7wsUm2VDopGDFyXkyhmgUh9V15QkEvnyqbgUPcagLcw2,Cy3WAM9NdjFG3kXCxXmD17WmtJMBKVpoBXabkSm88Xdt,BEEya88mme6JJ4rgshBR23eiDHmygUii9opUHE3qxnqK,Gq21dPAGVuuZucqBQeCkfbbqoEowL1t88igZekJ93CRu,79HFWkNoPhotXuFYi1ksuK5hE7AUnKasafP6c71hS9sM,Cp4pCm5JjDaZ4gXB8eSjNJvQ8eg7uK6awgjveofrSATz,DMHQ51qK2wChtDEUED54cqzbSLMLGvTygQCv5uLTUmZP,GDnz7cAA7hKEFmDyrk6mz3drybHWc3Gn14y9LCsvvtjE
# AllenHark Relay (default quic://fra.relay.allenhark.com:4433; or https://fra.relay.allenhark.com),
# pay per transaction, min tip 0.001 SOL. On once LANE_ALLENHARK_KEY is set.
LANE_ALLENHARK_KEY=
LANE_ALLENHARK_URL=
LANE_ALLENHARK_TIP_LAMPORTS=1000000
# Triton Jet: sendTransaction on your Triton endpoint (its token in the URL); no tip.
LANE_TRITON_ENABLED=false
LANE_TRITON_URL=
# 0slot (URL defaults to ZERO_SLOT_API_URL, http://de1.0slot.trade?api-key=...), Nozomi (base URL;
# key NOZOMI_API_KEY), Jito (JITO_BLOCK_ENGINE_URL, JITO_UUID), direct QUIC (QUIC_IDENTITY_KEYPAIR,
# empty: an unstaked identity). The old HOT_TIP_*_SOL and HOT_*_URL are still read as fallbacks.
LANE_ZEROSLOT_ENABLED=true
LANE_ZEROSLOT_TIP_LAMPORTS=1000000
LANE_NOZOMI_ENABLED=true
LANE_NOZOMI_URL=http://fra2.nozomi.temporal.xyz
LANE_NOZOMI_TIP_LAMPORTS=1000000
LANE_JITO_ENABLED=true
LANE_JITO_TIP_LAMPORTS=100000
LANE_QUIC_ENABLED=true
QUIC_IDENTITY_KEYPAIR=
# Priority fee of a hot buy with no rival bid seen (SOL at the CU limit), and the cap on priority
# fee plus tips. Over a rival's bid on the same coin it bids HOT_OUTBID_BPS more (1000 = 10%).
BUY_PRIORITY_FEE_SOL=0.0007
BUY_FEE_CAP_SOL=0.005
HOT_OUTBID_BPS=1000
# DRY_RUN only: send unlandable copies (all-zero blockhash) of paper buys, and of one other launch
# every HOT_DRY_SAMPLE_MS, through the lanes to time them. They cost nothing and cannot land.
HOT_DRY_LANES=false
HOT_DRY_SAMPLE_MS=10000
# Send a live buy once more when it failed on chain because it executed before the coin's create
# (Custom 3012). Off; such failures are counted either way (logs/hot_stats.log).
HOT_RESEND_BEFORE_CREATE=false
# Compute limit of sells (buys use CU).
SELL_COMPUTE_UNIT_LIMIT=80000

# The shred engine in the bot's own process (ported from pumpfeed): shreds from the ShredStream
# proxy, reassembled with Reed-Solomon recovery, decoded for the hot path, the slow path and the
# blockhash from shreds. It reads the proxy's output (one of its DEST_IP_PORTS) and captures the
# proxy's input port (needs CAP_NET_RAW, granted in deploy/bigboss.service); whichever copy of
# each shred arrives first counts. On by default; false: pumpfeed's UDP push on SHRED_UDP_PORT
# (kept for this release only). Both (with SHRED_UDP_PORT set) is a parity run:
# logs/engine_parity.csv. The proxy's DEST_IP_PORTS must include ENGINE_SHRED_BIND.
ENGINE_INPROC=true
ENGINE_SHRED_BIND=127.0.0.1:20003
ENGINE_CAPTURE_IFACE=ens3
ENGINE_CAPTURE_PORTS=20000
# Since 8 Oct nothing needs the shred stream (AllenHark): the preprocessed stream feeds the hot path,
# with LaserStream's transactions as the backup when it is silent for HOT_BACKUP_AFTER_MS (2000;
# HOT_BACKUP_FEED=off: none), and LaserStream's slot and block updates give the slot starts and
# the backup blockhash (HELIUS_SLOT_FEED=off: none). ENGINE_INPROC=false runs without shreds.
HOT_BACKUP_FEED=on
HOT_BACKUP_AFTER_MS=2000
HELIUS_SLOT_FEED=on
# Helius raw shreds (a paid seat sends them to this host): a third input of the same decoder, raced
# shred by shred against AllenHark's ("shred sources" in logs/hot_stats.log). Empty: none.
ENGINE_HELIUS_SHRED_BIND=
ENGINE_RCVBUF_BYTES=67108864
ENGINE_BUSY_POLL_US=50

# --- Scorecard entry + pXGQ exit (2026-10-12; research/filter-pXGQ-2026-10-12/FILTER_SPEC.md, SELL_STUDY.md)
# SCORECARD=true buys a followed launch only at SCORECARD_MIN points or more (config::scorecard);
# it replaces the dev-buy range, the deployer's minimum balance and wallet age, the relaunch skip
# and the no-buyers record. Default off.
SCORECARD=false
SCORECARD_MIN=61
# SELL_RULE=pxgq runs pXGQ's exit (utils::auto_sell::PxExit); ref (default) the bot's own.
# Overrides: PX_STOP_X PX_WAVE_MIN_SECS PX_WAVE_SECS PX_WAVE_SOL PX_SCALE_AT_X PX_SCALE_SHARE
# PX_TRAIL PX_TAKE_PROFIT_X PX_DUMP_DD PX_PRESSURE_X PX_PRESSURE_SOL PX_MAX_HOLD_SECS
SELL_RULE=ref
# Open positions at once (default 1).
MAX_OPEN_POSITIONS=1
# SQLite file for the scorecard's data.
DB_PATH=bigboss.db

# --- The store (SQLite, 2026-10-12, Part A; src/store) -----------------------------------------
# data/bigboss.sqlite (WAL, one writer thread, batched), tapes in data/tapes/YYYY-MM-DD.sqlite (7 days).
# Opens when STORE_DB=on or SCORECARD=true (the scorecard's tables live here; with only the scorecard,
# nothing else is written). Its tables of bigboss.db (DB_PATH) are copied over once.
STORE_DB=off
# off (only with STORE_DB=on): the files are no longer written and startup reads the store. Turn it
# off once tools/store_compare.py --since <first dual-write day> prints "all match".
STORE_FILES=on
# STORE_PATH=data/bigboss.sqlite
# STORE_TAPES_DIR=data/tapes
# Tools: target/release/store import|export <table>|stats|timings; tools/store_compare.py;
# scripts/db-backup.py (online, safe while the bot runs).

# Snipe test (2026-10-13, utils::snipe_test, processors::graduation): ONE test of the whole bot at a
# fixed size with shared caps. Launches: bigboss's own rules and exit (SNIPE_TEST_RULES=on adds the
# four test rules and the +30% / 15 s exit). Graduations (SNIPE_TEST_POOL=on): a curve from under
# 60 SOL to complete within 2 s, canonical pool, SOL quote, not mayhem, under 1.5x its opening at
# the migration slot's end; buy at once (10% guard), all out 240 s after the fill. Off by default.
# Log: logs/snipe_test.csv (+ store); report and gate: tools/snipe_test_report.py.
SNIPE_TEST=off
SNIPE_TEST_RULES=off
SNIPE_TEST_POOL=off
# The size of every test buy, set by hand (the dashboard can't change it in test mode).
SNIPE_TEST_SOL=0.1
SNIPE_TEST_MAX_LOSS_SOL=0.5
SNIPE_TEST_MAX_PER_DAY=100
SNIPE_TEST_MAX_PER_HOUR=4

# The whale rule (2026-10-13, processors::whale): buy big (min(WHALE_SIZE_SOL, max(0.5, 0.75 x the
# curve's real SOL))) into quiet young coins (60 s - 6.5 min, 0.3-5.4 SOL real, <= 71 buyers, no
# trade for 5 slots, <= 0.1 SOL in over 10 slots, dev buy < 1 SOL), all out at +23% or 90 s.
# Off by default. Log: logs/whale.csv (+ store); report and gate: tools/whale_report.py.
WHALE_MODE=off
WHALE_SIZE_SOL=1.5
WHALE_MAX_OPEN=3
WHALE_MAX_PER_HOUR=2
WHALE_MAX_PER_DAY=30
WHALE_DAY_LOSS_SOL=3
